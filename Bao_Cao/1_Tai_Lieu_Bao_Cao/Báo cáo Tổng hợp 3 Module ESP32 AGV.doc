text-align:left;mso-line-height-alt:12pt;background:rgb(26,32,44);" ><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;
background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >void autoDetectLidarPin() { if (lidar_pin_locked) return; // N&#7871;u &#273;&#227; kh&#243;a c&#7913;ng ch&#226;n th&#236; kh&#244;ng d&#242; l&#7841;i n&#7919;a &#273;&#7875; ti&#7871;t ki&#7879;m CPU // Th&#7917; nghi&#7879;m c&#7845;u h&#236;nh C&#7863;p 1: RX = GPIO 16, Motor Enable = GPIO 15 if (tryLidarPinPair(16, 15, 115200)) { active_lidar_rx = 16; active_lidar_motor = 15; lidar_pin_locked = true; // KH&#211;A C&#7912;NG C&#7844;U H&#204;NH NGAY L&#7852;P T&#7912;C s3Println("[LIDAR-OK] &gt;&gt; DA XAC DINH DUNG CHAN: RX=GPIO16 | M_EN=GPIO15 -&gt; DA KHOA!"); return; } // N&#7871;u C&#7863;p 1 th&#7845;t b&#7841;i, t&#7921; &#273;&#7897;ng chuy&#7875;n sang c&#7845;u h&#236;nh C&#7863;p 2: RX = GPIO 15, Motor Enable = GPIO 16 if (tryLidarPinPair(15, 16, 115200)) { active_lidar_rx = 15; active_lidar_motor = 16; lidar_pin_locked = true; // KH&#211;A C&#7912;NG C&#7844;U H&#204;NH NGAY L&#7852;P T&#7912;C s3Println("[LIDAR-OK] &gt;&gt; DA XAC DINH DUNG CHAN: RX=GPIO15 | M_EN=GPIO16 -&gt; DA KHOA!"); return; } } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=p  style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-style:italic;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >&#221; ngh&#297;a k&#7929; thu&#7853;t:</span></i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;C&#417; ch&#7871; </span><b><span class="15"  style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(197,48,48);font-weight:bold;font-size:12.0000pt;
background:rgb(237,242,247);mso-shading:rgb(237,242,247);" >lidar_pin_locked</span></b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;&#273;&#7843;m b&#7843;o thu&#7853;t to&#225;n d&#242; ch&#226;n ch&#7881; ch&#7841;y 1 l&#7847;n duy nh&#7845;t khi kh&#7903;i &#273;&#7897;ng. Khi &#273;&#227; b&#7855;t &#273;&#432;&#7907;c lu&#7891;ng d&#7919; li&#7879;u, to&#224;n b&#7897; t&#224;i nguy&#234;n CPU &#273;&#432;&#7907;c chuy&#7875;n sang ph&#7909;c v&#7909; vi&#7879;c &#273;&#243;ng g&#243;i WebSocket v&#224; truy&#7873;n &#273;i&#7875;m laser l&#234;n Server. </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h3 style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
