background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >bool connectWebSocketTunnel() { if (s3Client.connected()) return true; s3Printf("[WSS] Dang thiet lap duong ong bao mat WSS toi: %s:443\n", tunnel_host.c_str()); s3Client.setInsecure(); // Ch&#7845;p nh&#7853;n ch&#7913;ng ch&#7881; SSL/TLS c&#244;ng c&#7897;ng c&#7911;a Cloudflare if (!s3Client.connect(tunnel_host.c_str(), 443)) { s3Println("[WSS-ERR] Ket noi SSL cong 443 that bai!"); return false; } // T&#7841;o kh&#243;a b&#7855;t tay ng&#7851;u nhi&#234;n Sec-WebSocket-Key chu&#7849;n RFC 6455 String key = "AGVS3LidarKey" + String(random(100000, 999999)); String req = "GET /ws/push_lidar HTTP/1.1\r\n"; req += "Host: " + tunnel_host + "\r\n"; req += "Upgrade: websocket\r\n"; req += "Connection: Upgrade\r\n"; req += "Sec-WebSocket-Key: " + key + "\r\n"; req += "Sec-WebSocket-Version: 13\r\n"; req += "X-Secret-Key: " + String(agv_secret_key) + "\r\n\r\n"; s3Client.print(req); // G&#7917;i b&#7843;n tin Upgrade HTTP l&#234;n Server // &#272;&#7885;c ph&#7843;n h&#7891;i t&#7915; Server: Ph&#7843;i nh&#7853;n &#273;&#432;&#7907;c m&#227; tr&#7841;ng th&#225;i HTTP 101 Switching Protocols unsigned long t0 = millis(); while (millis() - t0 &lt; 4000) { if (s3Client.available()) { String line = s3Client.readStringUntil('\n'); if (line.indexOf("101") &gt; 0) { s3Println("[WSS-SUCCESS] &gt;&gt; BAT TAY WEBSOCKET NATIVE THANH CONG! KHONG CAN THU VIEN NGOAI!"); ws_connected = true; return true; } } } s3Client.stop(); return false; } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=p  style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-style:italic;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >&#221; ngh&#297;a k&#7929; thu&#7853;t:</span></i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;&#272;o&#7841;n m&#227; n&#224;y l&#224; ch&#236;a kh&#243;a gi&#250;p tri&#7879;t ti&#234;u ho&#224;n to&#224;n s&#7921; ph&#7909; thu&#7897;c v&#224;o th&#432; vi&#7879;n b&#234;n ngo&#224;i </span><b><span class="15"  style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
