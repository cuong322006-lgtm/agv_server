background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >void readIncomingServerCommands() { while (s3Client.available() &gt; 0) { uint8_t b1 = s3Client.read(); // B&#243;c t&#225;ch Opcode g&#243;i tin WebSocket t&#7915; Server (0x81 = Text frame &#273;i&#7873;u khi&#7875;n) if ((b1 & 0x0F) == 0x01) { if (s3Client.available() &gt; 0) { uint8_t b2 = s3Client.read(); size_t payload_len = b2 & 0x7F; // &#272;&#7897; d&#224;i l&#7879;nh String cmd_str = ""; for (size_t i = 0; i &lt; payload_len; i++) { if (s3Client.available()) cmd_str += (char)s3Client.read(); } // Ki&#7875;m tra l&#7879;nh c&#7845;u h&#236;nh Wi-Fi OTA t&#7915; xa ho&#7863;c l&#7879;nh x&#243;a m&#7841;ng if (cmd_str == "#WIFI:CLEAR") { clearWiFiFromFlash(); syncClearToSiblingESP(); } else if (cmd_str.length() == 1) { handleControlCommand(cmd_str[0]); // Th&#7921;c thi l&#7879;nh &#273;&#7897;ng h&#7885;c W, A, S, D, G, X } } } } } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=p  style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
