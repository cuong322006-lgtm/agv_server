text-align:left;mso-line-height-alt:12pt;background:rgb(26,32,44);" ><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;
background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >camera_config_t config; config.ledc_channel = LEDC_CHANNEL_0; config.ledc_timer = LEDC_TIMER_0; config.pin_d0 = Y2_GPIO_NUM; config.pin_d1 = Y3_GPIO_NUM; // ... (g&#225;n to&#224;n b&#7897; c&#225;c ch&#226;n d&#7919; li&#7879;u D0-D7 v&#224; xung nh&#7883;p) config.xclk_freq_hz = 20000000; // Xung nh&#7883;p XCLK 20MHz config.pixel_format = PIXFORMAT_JPEG; // N&#233;n &#7843;nh tr&#7921;c ti&#7871;p sang &#273;&#7883;nh d&#7841;ng JPEG config.frame_size = FRAMESIZE_HQVGA; // &#272;&#7897; ph&#226;n gi&#7843;i chu&#7849;n n&#233;t 240x176 config.jpeg_quality = 13; // Ch&#7845;t l&#432;&#7907;ng n&#233;n kh&#7903;i t&#7841;o (10-15 r&#7845;t n&#233;t) config.fb_count = 2; // C&#7845;u h&#236;nh &#273;&#7879;m &#273;&#244;i (Double Buffer) trong PSRAM config.grab_mode = CAMERA_GRAB_LATEST; // Lu&#244;n l&#7845;y khung h&#236;nh m&#7899;i nh&#7845;t, lo&#7841;i b&#7887; &#7843;nh c&#361; config.fb_location = CAMERA_FB_IN_PSRAM; // &#272;&#7863;t b&#7897; &#273;&#7879;m khung h&#236;nh trong b&#7897; nh&#7899; 4MB PSRAM esp_err_t err = esp_camera_init(&config); // G&#7885;i h&#224;m kh&#7903;i t&#7841;o ph&#7847;n c&#7913;ng </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=p  style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-style:italic;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >&#221; ngh&#297;a k&#7929; thu&#7853;t:</span></i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;Ch&#7871; &#273;&#7897; </span><b><span class="15"  style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(197,48,48);font-weight:bold;font-size:12.0000pt;
background:rgb(237,242,247);mso-shading:rgb(237,242,247);" >CAMERA_GRAB_LATEST</span></b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;k&#7871;t h&#7907;p v&#7899;i &#273;&#7879;m &#273;&#244;i </span><b><span class="15"  style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(197,48,48);font-weight:bold;font-size:12.0000pt;
background:rgb(237,242,247);mso-shading:rgb(237,242,247);" >fb_count = 2</span></b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;trong PSRAM &#273;&#7843;m b&#7843;o m&#7895;i khi t&#225;c v&#7909; l&#7845;y &#7843;nh &#273;&#432;&#7907;c g&#7885;i, n&#243; s&#7869; nh&#7853;n ngay b&#7913;c &#7843;nh v&#7915;a m&#7899;i &#273;&#432;&#7907;c c&#7843;m bi&#7871;n ch&#7909;p xong, lo&#7841;i b&#7887; ho&#224;n to&#224;n c&#225;c khung h&#236;nh t&#7891;n &#273;&#7885;ng trong b&#7897; &#273;&#7879;m. </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h3 style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >Kh&#7889;i 3: T&#225;c v&#7909; truy&#7873;n h&#236;nh &#7843;nh FreeRTOS tr&#234;n Core 1 (streamTask)</span></b><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h3><p class=MsoNormal  style="margin-top:8.0000pt;margin-right:0.0000pt;margin-bottom:8.0000pt;
margin-left:0.0000pt;border-left:4.5000pt solid rgb(5,196,107);mso-border-left-alt:4.5000pt solid rgb(5,196,107);
padding:0pt 0pt 0pt 12pt ;word-break:break-all;mso-pagination:widow-orphan;
text-align:left;mso-line-height-alt:12pt;background:rgb(26,32,44);" ><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;
background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >void streamTask(void* pvParameters) { while (true) { if (!ws_connected) { vTaskDelay(pdMS_TO_TICKS(100)); continue; } // Ki&#7875;m tra ki&#7875;m so&#225;t lu&#7891;ng ACK: N&#7871;u &#7843;nh tr&#432;&#7899;c ch&#432;a g&#7917;i xong th&#236; t&#7841;m ho&#227;n drainServerAcks(); if (in_flight_frames &gt;= 1) { vTaskDelay(pdMS_TO_TICKS(5)); continue; } // L&#7845;y khung h&#236;nh m&#7899;i nh&#7845;t t&#7915; c&#7843;m bi&#7871;n camera_fb_t* fb = esp_camera_fb_get(); if (!fb) { vTaskDelay(pdMS_TO_TICKS(10)); continue; } // &#272;&#243;ng g&#243;i v&#224; g&#7917;i qua &#273;&#432;&#7901;ng &#7889;ng WebSocket WSS unsigned long t0 = millis(); bool ok = sendFrameOverWebSocket(fb-&gt;buf, fb-&gt;len); unsigned long send_ms = millis() - t0; esp_camera_fb_return(fb); // Gi&#7843;i ph&#243;ng b&#7897; &#273;&#7879;m khung h&#236;nh ngay l&#7853;p t&#7913;c if (ok) { in_flight_frames++; // T&#259;ng c&#7901; &#7843;nh &#273;ang truy&#7873;n, ch&#7901; Server tr&#7843; v&#7873; k&#253; t&#7921; 'K' adjustQualityByNetworkSpeed(send_ms, fb-&gt;len); // T&#7921; &#273;&#7897;ng th&#237;ch &#7913;ng ch&#7845;t l&#432;&#7907;ng } vTaskDelay(pdMS_TO_TICKS(5)); // Nh&#432;&#7901;ng CPU cho c&#225;c t&#225;c v&#7909; n&#7873;n } } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=p  style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-style:italic;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >&#221; ngh&#297;a k&#7929; thu&#7853;t:</span></i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;T&#225;c v&#7909; n&#224;y ch&#7841;y v&#244; t&#7853;n tr&#234;n Core 1. Vi&#7879;c g&#7885;i h&#224;m </span><b><span class="15"  style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(197,48,48);font-weight:bold;font-size:12.0000pt;
background:rgb(237,242,247);mso-shading:rgb(237,242,247);" >esp_camera_fb_return(fb)</span></b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;ngay sau khi sao ch&#233;p &#7843;nh v&#224;o b&#7897; &#273;&#7879;m g&#7897;p gi&#7843;i ph&#243;ng l&#7853;p t&#7913;c b&#7897; &#273;&#7879;m DMA &#273;&#7875; c&#7843;m bi&#7871;n ti&#7871;p t&#7909;c thu nh&#7853;n khung h&#236;nh ti&#7871;p theo m&#224; kh&#244;ng b&#7883; r&#242; r&#7881; b&#7897; nh&#7899; (memory leak). </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h3 style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >Kh&#7889;i 4: H&#224;m &#273;&#243;ng g&#243;i v&#224; g&#7917;i khung h&#236;nh WebSocket nh&#7883; ph&#226;n (sendFrameOverWebSocket)</span></b><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h3><p class=MsoNormal  style="margin-top:8.0000pt;margin-right:0.0000pt;margin-bottom:8.0000pt;
