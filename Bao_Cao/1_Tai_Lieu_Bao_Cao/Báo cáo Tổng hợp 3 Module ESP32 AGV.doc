background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >bool sendFrameOverWebSocket(const uint8_t* buf, size_t len) { size_t header_size = 0; ws_pkt_buf[0] = 0x82; // 0x80 (FIN bit b&#225;o g&#243;i tin tr&#7885;n v&#7865;n) | 0x02 (Opcode nh&#7883; ph&#226;n Binary) // M&#227; h&#243;a &#273;&#7897; d&#224;i payload theo chu&#7849;n RFC 6455 k&#232;m c&#7901; MASK (0x80) if (len &lt;= 125) { ws_pkt_buf[1] = 0x80 | (uint8_t)len; header_size = 2; } else if (len &lt;= 65535) { ws_pkt_buf[1] = 0x80 | 126; ws_pkt_buf[2] = (len &gt;&gt; 8) & 0xFF; ws_pkt_buf[3] = len & 0xFF; header_size = 4; } // T&#7841;o kh&#243;a m&#7863;t n&#7841; ng&#7851;u nhi&#234;n 4 byte (Masking Key) b&#7855;t bu&#7897;c &#273;&#7889;i v&#7899;i Client uint8_t mask[4] = { (uint8_t)esp_random(), (uint8_t)esp_random(), (uint8_t)esp_random(), (uint8_t)esp_random() }; memcpy(ws_pkt_buf + header_size, mask, 4); header_size += 4; // &#193;p d&#7909;ng ph&#233;p to&#225;n XOR Masking v&#224;o d&#7919; li&#7879;u &#7843;nh JPEG uint8_t* payload_dst = ws_pkt_buf + header_size; for (size_t i = 0; i &lt; len; i++) { payload_dst[i] = buf[i] ^ mask[i % 4]; } // G&#7917;i to&#224;n b&#7897; g&#243;i tin nh&#7883; ph&#226;n trong &#272;&#218;NG 1 L&#7846;N G&#7884;I H&#192;M duy nh&#7845;t size_t total_size = header_size + len; size_t written = secureClient.write(ws_pkt_buf, total_size); return (written == total_size); } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><p class=p  style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-style:italic;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >&#221; ngh&#297;a k&#7929; thu&#7853;t:</span></i><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(26,32,44);font-size:12.0000pt;mso-font-kerning:0.0000pt;" >&nbsp;&#272;&#226;y l&#224; h&#224;m t&#7921; &#273;&#243;ng g&#243;i WebSocket ti&#234;u chu&#7849;n th&#7871; gi&#7899;i (RFC 6455). Vi&#7879;c t&#7921; th&#7921;c hi&#7879;n &#273;&#243;ng g&#243;i nh&#7883; ph&#226;n thay v&#236; d&#249;ng c&#225;c th&#432; vi&#7879;n trung gian c&#7891;ng k&#7873;nh gi&#250;p t&#7889;i &#432;u h&#243;a 100% t&#224;i nguy&#234;n CPU, kh&#244;ng ph&#225;t sinh c&#7845;p ph&#225;t b&#7897; nh&#7899; &#273;&#7897;ng (malloc/free) l&#224;m ph&#226;n m&#7843;nh RAM. </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h3 style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
