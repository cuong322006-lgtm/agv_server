background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >void loadWiFiFromFlash() { wifiPrefs.begin("agv_wifi", true); // M&#7903; namespace "agv_wifi" &#7903; ch&#7871; &#273;&#7897; Read-Only saved_ssid = wifiPrefs.getString("ssid", ""); saved_pass = wifiPrefs.getString("pass", ""); wifiPrefs.end(); } void saveWiFiToFlash(const String& new_ssid, const String& new_pass) { wifiPrefs.begin("agv_wifi", false); // M&#7903; namespace &#7903; ch&#7871; &#273;&#7897; Read-Write wifiPrefs.putString("ssid", new_ssid); wifiPrefs.putString("pass", new_pass); wifiPrefs.end(); saved_ssid = new_ssid; saved_pass = new_pass; } void clearWiFiFromFlash() { wifiPrefs.begin("agv_wifi", false); wifiPrefs.clear(); // X&#243;a s&#7841;ch to&#224;n b&#7897; key trong namespace wifiPrefs.end(); saved_ssid = ""; saved_pass = ""; } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h3 style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >Kh&#7889;i 2: H&#224;m kh&#7903;i t&#7841;o Captive Portal DNS v&#224; &#273;&#7883;nh tuy&#7871;n Web Server</span></b><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h3><p class=MsoNormal  style="margin-top:8.0000pt;margin-right:0.0000pt;margin-bottom:8.0000pt;
margin-left:0.0000pt;border-left:4.5000pt solid rgb(5,196,107);mso-border-left-alt:4.5000pt solid rgb(5,196,107);
padding:0pt 0pt 0pt 12pt ;word-break:break-all;mso-pagination:widow-orphan;
text-align:left;mso-line-height-alt:12pt;background:rgb(26,32,44);" ><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;
background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >void startSmartWiFiPortal() { WiFi.mode(WIFI_AP_STA); // B&#7853;t ch&#7871; &#273;&#7897; k&#233;p: v&#7915;a ph&#225;t AP v&#7915;a c&#243; th&#7875; l&#224;m tr&#7841;m STA IPAddress apIP(192, 168, 4, 1); WiFi.softAPConfig(apIP, apIP, IPAddress(255, 255, 255, 0)); WiFi.softAP(ap_setup_name, ap_password); // Ph&#225;t AP c&#243; m&#7853;t kh&#7849;u WPA2-PSK: 12345678 // B&#7853;t m&#225;y ch&#7911; DNS c&#7893;ng 53: M&#7885;i t&#234;n mi&#7873;n &#273;&#7873;u tr&#7887; v&#7873; IP 192.168.4.1 dnsServer.setErrorReplyCode(DNSReplyCode::NoError); dnsServer.start(DNS_PORT, "*", apIP); // &#272;&#259;ng k&#253; c&#225;c &#273;&#7883;nh tuy&#7871;n Captive Portal t&#7921; &#273;&#7897;ng portalServer.on("/", HTTP_GET, handlePortalRoot); portalServer.on("/save", HTTP_POST, handlePortalSave); portalServer.on("/clear", HTTP_POST, handlePortalClear); portalServer.on("/peer_sync", HTTP_POST, handlePeerSync); portalServer.on("/peer_clear", HTTP_POST, handlePeerClear); // &#272;&#243;n &#273;&#7847;u c&#225;c g&#243;i tin ki&#7875;m tra k&#7871;t n&#7889;i m&#7841;ng c&#7911;a &#273;i&#7879;n tho&#7841;i portalServer.on("/generate_204", HTTP_GET, handlePortalRoot); portalServer.on("/gen_204", HTTP_GET, handlePortalRoot); portalServer.on("/hotspot-detect.html", HTTP_GET, handlePortalRoot); portalServer.on("/connecttest.txt", HTTP_GET, handleCaptiveRedirect); portalServer.on("/redirect", HTTP_GET, handlePortalRoot); portalServer.onNotFound(handlePortalRoot); portalServer.begin(); // V&#242;ng l&#7863;p ch&#7901; ng&#432;&#7901;i d&#249;ng t&#432;&#417;ng t&#225;c trong t&#7889;i &#273;a 90 gi&#226;y unsigned long portal_start = millis(); while (!portal_saved_new_wifi && (millis() - portal_start &lt; 90000)) { dnsServer.processNextRequest(); portalServer.handleClient(); delay(5); } dnsServer.stop(); portalServer.stop(); WiFi.softAPdisconnect(true); } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;" ><o:p></o:p></span></p><h3 style="mso-pagination:widow-orphan;mso-line-height-alt:12pt;" ><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" >Kh&#7889;i 3: H&#224;m ph&#225;t t&#237;n hi&#7879;u &#273;&#7891;ng b&#7897; P2P sang vi &#273;i&#7873;u khi&#7875;n anh em (syncWiFiToSiblingESP)</span></b><b><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:SimSun;
color:rgb(45,55,72);font-weight:bold;font-size:12.0000pt;
mso-font-kerning:0.0000pt;" ><o:p></o:p></span></b></h3><p class=MsoNormal  style="margin-top:8.0000pt;margin-right:0.0000pt;margin-bottom:8.0000pt;
margin-left:0.0000pt;border-left:4.5000pt solid rgb(5,196,107);mso-border-left-alt:4.5000pt solid rgb(5,196,107);
padding:0pt 0pt 0pt 12pt ;word-break:break-all;mso-pagination:widow-orphan;
text-align:left;mso-line-height-alt:12pt;background:rgb(26,32,44);" ><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
color:rgb(226,232,240);font-size:12.0000pt;mso-font-kerning:0.0000pt;
background:rgb(26,32,44);mso-shading:rgb(26,32,44);color:rgb(255,255,255); color:rgb(255,255,255);" >void syncWiFiToSiblingESP(const String& ssid_to_send, const String& pass_to_send) { // Qu&#233;t t&#236;m xem vi &#273;i&#7873;u khi&#7875;n anh em c&#243; &#273;ang ph&#225;t Wi-Fi AP c&#7845;u h&#236;nh hay kh&#244;ng int n = WiFi.scanNetworks(); bool found_peer = false; for (int i = 0; i &lt; n; i++) { if (WiFi.SSID(i) == peer_ap_name) { found_peer = true; break; } } WiFi.scanDelete(); if (found_peer) { // K&#7871;t n&#7889;i v&#224;o AP c&#7911;a vi &#273;i&#7873;u khi&#7875;n anh em v&#7899;i m&#7853;t kh&#7849;u b&#7843;o m&#7853;t 12345678 WiFi.begin(peer_ap_name, "12345678"); unsigned long t0 = millis(); while (WiFi.status() != WL_CONNECTED && (millis() - t0 &lt; 6000)) delay(100); if (WiFi.status() == WL_CONNECTED) { // G&#7917;i b&#7843;n tin HTTP POST mang d&#7919; li&#7879;u Wi-Fi m&#7899;i sang cho anh em HTTPClient http; http.begin("http://192.168.4.1/peer_sync"); http.addHeader("Content-Type", "application/x-www-form-urlencoded"); String postData = "ssid=" + ssid_to_send + "&pass=" + pass_to_send; http.POST(postData); http.end(); } } } </span><span style="mso-spacerun:'yes';font-family:'Times New Roman';mso-fareast-font-family:Consolas;
