p.MsoNormal{
mso-style-name:Normal;
mso-style-parent:"";
margin:0pt;
margin-bottom:.0001pt;
text-align:left;
font-family:Calibri;
mso-fareast-font-family:SimSun;
mso-bidi-font-family:'Times New Roman';
font-size:12.0000pt;
}

h1{
mso-style-name:"Heading 1";
mso-style-next:Normal;
margin-top:20.0000pt;
margin-bottom:10.0000pt;
border-left:6.0000pt solid rgb(43,108,176);
mso-border-left-alt:6.0000pt solid rgb(43,108,176);
padding:0pt 0pt 0pt 12pt ;
text-align:left;
background:rgb(237,242,247);
font-family:'Times New Roman';
mso-fareast-font-family:SimSun;
color:rgb(26,54,93);
font-weight:bold;
text-transform:uppercase;
font-size:15.0000pt;
mso-font-kerning:22.0000pt;
}

h2{
mso-style-name:"Heading 2";
mso-style-noshow:yes;
mso-style-next:Normal;
margin-top:14.0000pt;
margin-bottom:6.0000pt;
border-bottom:1.5000pt solid rgb(203,213,224);
mso-border-bottom-alt:1.5000pt solid rgb(203,213,224);
padding:0pt 0pt 3pt 0pt ;
text-align:left;
font-family:'Times New Roman';
mso-fareast-font-family:SimSun;
color:rgb(43,108,176);
font-weight:bold;
font-size:13.0000pt;
}

h3{
mso-style-name:"Heading 3";
mso-style-noshow:yes;
mso-style-next:Normal;
margin-top:10.0000pt;
margin-bottom:4.0000pt;
text-align:left;
font-family:'Times New Roman';
mso-fareast-font-family:SimSun;
color:rgb(45,55,72);
font-weight:bold;
font-size:12.0000pt;
}

h4{
mso-style-name:"Heading 4";
mso-style-noshow:yes;
mso-style-next:Normal;
margin-top:5.0000pt;
margin-bottom:5.0000pt;
mso-margin-top-alt:auto;
mso-margin-bottom-alt:auto;
text-align:left;
font-family:SimSun;
font-weight:bold;
font-size:12.0000pt;
}

h5{
mso-style-name:"Heading 5";
mso-style-noshow:yes;
mso-style-next:Normal;
margin-top:5.0000pt;
margin-bottom:5.0000pt;
mso-margin-top-alt:auto;
mso-margin-bottom-alt:auto;
text-align:left;
font-family:SimSun;
font-weight:bold;
font-size:10.0000pt;
}

h6{
mso-style-name:"Heading 6";
mso-style-noshow:yes;
mso-style-next:Normal;
margin-top:5.0000pt;
margin-bottom:5.0000pt;
mso-margin-top-alt:auto;
mso-margin-bottom-alt:auto;
text-align:left;
font-family:SimSun;
font-weight:bold;
font-size:7.5000pt;
}

span.10{
font-family:'Times New Roman';
}

span.15{
font-family:Consolas;
color:rgb(197,48,48);
font-weight:bold;
font-size:10.5000pt;
background:rgb(237,242,247);
mso-shading:rgb(237,242,247);
}

p.16{
mso-style-name:code-box;
margin-top:8.0000pt;
margin-right:0.0000pt;
margin-bottom:8.0000pt;
margin-left:0.0000pt;
border-left:4.5000pt solid rgb(5,196,107);
mso-border-left-alt:4.5000pt solid rgb(5,196,107);
padding:0pt 0pt 0pt 12pt ;
word-break:break-all;
text-align:left;
mso-line-height-alt:12pt;
background:rgb(26,32,44);
font-family:Consolas;
color:rgb(226,232,240);
font-size:9.5000pt;
}

p.pre{
mso-style-name:"HTML Preformatted";
margin:0pt;
margin-bottom:.0001pt;
tab-stops:left blank 45.8000pt left blank 91.6000pt left blank 137.4000pt left blank 183.2000pt left blank 229.0000pt left blank 274.8000pt left blank 320.6000pt left blank 366.4000pt left blank 412.2000pt left blank 458.0000pt left blank 503.8000pt left blank 549.6000pt left blank 595.4000pt left blank 641.2000pt left blank 687.0000pt left blank 732.8000pt ;
text-align:left;
font-family:SimSun;
font-size:12.0000pt;
}

p.p{
mso-style-name:"Normal \(Web\)";
margin-top:4.0000pt;
margin-right:0.0000pt;
margin-bottom:6.0000pt;
margin-left:0.0000pt;
text-align:justify;
text-justify:inter-ideograph;
